"2-1-17": {"Mēlum mēlum": "மேலும் மேலும்", "mēlum": "மேலும்", "mēlum mēlum": "மேலும் மேலும்", "kālvāygaḷ mēlum mēlum kuṛugalāgiṉṛaṉa": "கால்வாய்கள் மேலும் மேலும் குறுகலாகின்றன", "mēlum mēlum adigamāṉa pārvaiyāḷargaḷ": "மேலும் மேலும் அதிகமான பார்வையாளர்கள்", "pōgap pōga": "போகப் போக"},
"2-2-0": {"talaikku mēl vēlai": "தலைக்கு மேல் வேலை", "mūkkiṉ mēl kōbam": "மூக்கின் மேல் கோபம்", "maṉam viṭṭup pēchu": "மனம் விட்டுப் பேசு", "kai vanda kalai": "கை வந்த கலை", "kaṇṇum karuttumāga": "கண்ணும் கருத்துமாக"},
"2-2-2": {"chāppiṭṭīngaḷā": "சாப்பிட்டீங்களா", "mella": "மெல்ல", "pōyiṭṭu varēṉ": "போயிட்டு வரேன்", "Chāppiṭṭīngaḷā": "சாப்பிட்டீங்களா", "chāppiṭṭēṉ": "சாப்பிட்டேன்", "Mella": "மெல்ல", "mellap pēchungaḷ": "மெல்லப் பேசுங்கள்", "mella mella": "மெல்ல மெல்ல", "pōyiṭṭu vānga": "போயிட்டு வாங்க"},
"2-2-4": {"Pōla": "போல", "pōla": "போல", "neruppu pōla": "நெருப்பு போல", "kaṉavu pōla irundadu": "கனவு போல இருந்தது", "maḻai varum pōla irukkiṛadu": "மழை வரும் போல இருக்கிறது", "pōṉṛa": "போன்ற", "idu pōṉṛa": "இது போன்ற"},
"2-2-7": {"Yōchi": "யோசி", "yōchikkāmal": "யோசிக்காமல்", "tūngu": "தூங்கு", "tūngāmal": "தூங்காமல்", "teriyum": "தெரியும்", "teriyāmal": "தெரியாமல்", "tūngāmal pēchiṉōm": "தூங்காமல் பேசினோம்", "maṛakkāmal": "மறக்காமல்", "illai": "இல்லை", "illāmal": "இல்லாமல்", "tiṭṭam illāmal": "திட்டம் இல்லாமல்"},
"2-2-11": {"paḻamoḻi": "பழமொழி", "Taṉimaram tōppāgādu": "தனிமரம் தோப்பாகாது", "Chiṛu tuḷi peru veḷḷam": "சிறு துளி பெரு வெள்ளம்", "ikkaraikku akkarai pachchai": "இக்கரைக்கு அக்கரை பச்சை", "eṉṛu cholvārgaḷ": "என்று சொல்வார்கள்"}
}
